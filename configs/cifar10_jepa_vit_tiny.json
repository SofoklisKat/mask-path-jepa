{
  "run_name": "jepa_vit_tiny_cifar10",
  "dataset": "cifar10",
  "training_mode": "jepa_ema",
  "backbone": "vit_tiny",
  "embed_dim": 192,
  "vit_patch_size": 4,
  "vit_depth": 12,
  "vit_heads": 3,
  "vit_mlp_dim": 768,
  "use_ema_target": true,
  "ema_momentum": 0.996,
  "anchor_mode": "predictor_corrupt",
  "corrupt_schedule": "block",
  "mask_ratio": 0.6,
  "epochs": 100,
  "batch_size": 256,
  "triplet_weight": 0.0,
  "jepa_infonce_weight": 0.0,
  "aug_infonce_weight": 0.0,
  "align_weight": 1.0,
  "aug_align_weight": 0.0,
  "lr": 0.0003,
  "eval_every": 10,
  "knn_k": 20,
  "probe_epochs": 50,
  "seed": 42,
  "output_dir": "./results"
}
