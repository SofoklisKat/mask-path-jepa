{
  "run_name": "jepa_gated_centroid_nn_cifar10",
  "dataset": "cifar10",
  "training_mode": "jepa_gated_centroid_nn",
  "backbone": "resnet18",
  "embed_dim": 512,
  "use_ema_target": true,
  "ema_momentum": 0.996,
  "anchor_mode": "predictor_corrupt",
  "corrupt_schedule": "block",
  "mask_ratio": 0.6,
  "epochs": 100,
  "batch_size": 768,
  "triplet_weight": 0.0,
  "align_weight": 1.0,
  "nn_num_augs": 6,
  "nn_tau": 0.995,
  "nn_tau_end": 0.98,
  "nn_k": 1,
  "nn_weight": 1.0,
  "nn_mutual": true,
  "nn_soft_weight": true,
  "nn_encode_chunk": 256,
  "nn_precompute_augs": true,
  "nn_aug_cache_dir": "./data/aug_banks",
  "nn_aug_force_recompute": false,
  "aug_brightness": 0.4,
  "aug_contrast": 0.4,
  "aug_saturation": 0.4,
  "aug_hue": 0.1,
  "lr": 0.0003,
  "eval_every": 10,
  "knn_k": 20,
  "probe_epochs": 50,
  "seed": 42,
  "output_dir": "./results"
}
