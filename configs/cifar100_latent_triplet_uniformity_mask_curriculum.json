{
  "run_name": "latent_triplet_uniformity_mask_curriculum",
  "dataset": "cifar100",
  "training_mode": "latent_triplet_uniformity",
  "anchor_mode": "predictor_corrupt",
  "corrupt_schedule": "block_curriculum",
  "patch_blur_ratio_min": 0.1,
  "mask_ratio": 0.3,
  "epochs": 100,
  "batch_size": 256,
  "triplet_weight": 0.5,
  "uniformity_weight": 0.5,
  "uniformity_t": 2.0,
  "negative_mode": "scramble",
  "scramble_patch_size": 4,
  "margin": 0.2,
  "embed_dim": 256,
  "lr": 0.0003,
  "eval_every": 10,
  "knn_k": 20,
  "probe_epochs": 50,
  "seed": 42,
  "output_dir": "./results/paper_cifar100"
}
