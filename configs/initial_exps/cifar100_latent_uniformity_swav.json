{
  "run_name": "latent_uniformity_swav",
  "dataset": "cifar100",
  "training_mode": "latent_uniformity",
  "anchor_mode": "predictor_corrupt",
  "corrupt_schedule": "block",
  "epochs": 100,
  "batch_size": 256,
  "triplet_weight": 0.0,
  "uniformity_weight": 0.5,
  "uniformity_t": 2.0,
  "proto_weight": 0.5,
  "proto_num": 100,
  "proto_temperature": 0.1,
  "sinkhorn_iters": 3,
  "sinkhorn_eps": 0.05,
  "margin": 0.2,
  "mask_ratio": 0.6,
  "embed_dim": 256,
  "lr": 0.0003,
  "eval_every": 10,
  "knn_k": 20,
  "probe_epochs": 50,
  "seed": 42,
  "output_dir": "./results/paper_cifar100"
}
